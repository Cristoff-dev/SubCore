# ==========================================
# SUBCORE - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# Database Connection (Supabase / PostgreSQL)
# Used by Prisma ORM with connection pooling (Transaction mode)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgboiler=true"

# Direct connection to DB (Used for migrations by Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth & Public Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Stripe Secret & Webhook Keys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Plan Price IDs (From Stripe Dashboard -> Products)
NEXT_PUBLIC_STRIPE_HOBBY_PLAN_ID="price_..."
NEXT_PUBLIC_STRIPE_PRO_PLAN_ID="price_..."

# Cron Job Security Secret
CRON_SECRET="your-custom-super-secret-key-here"

# Resend Email Service API Key
RESEND_API_KEY="re_..."